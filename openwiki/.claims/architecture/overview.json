    {
      "id": "claim_60578e0314a646bca24b8da1785b1447",
      "statement": "The CLI resolves fromEnv markers (secrets referencing environment variables) at serialization time — in updatePluginConfig and in ServiceClient's body helper — not earlier, so a marker never reaches JSON.stringify as a raw object.",
