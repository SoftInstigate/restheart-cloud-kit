    },
    {
      "id": "claim_33125cae88a444e8b3b16bc7059805c7",
      "statement": "All Stripe interaction happens through Stripe-hosted pages — no Stripe.js is loaded client-side. createCheckoutSession, openBillingPortal, and createOrder each return a URL that the caller redirects to with window.location.href. Prices are resolved server-side from the service's own catalog.",
      "evidence": [
        {
          "resource": "repo://packages/kit/src/orders.ts#L76-L124",
          "version": "repo-lines-v1:sha256:5f37d1f40cdc8ed9316ac45fa921c26ec27d028d29c07bb07aaa2aa40c773807:"
        },
        {
