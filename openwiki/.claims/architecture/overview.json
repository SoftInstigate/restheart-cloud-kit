          "version": "repo-lines-v1:sha256:ebe1987c932c9b8108605a4557af2a751f223cb758b03e89478ebc9f597aaf93:"
        }
      ]
    },
    {
      "id": "claim_da5bf4a493334da99835d8b19d47c823",
      "statement": "The payments subsystem covers two distinct commerce models: subscriptions (recurring billing tied to a team, governed by the @subscription ACL variable resolved server-side) and products/orders (one-time purchases where the order status is moved by Stripe's webhook, never by the client redirect).",
      "evidence": [
        {
          "resource": "repo://packages/kit/src/orders.ts#L1-L13",
          "version": "repo-lines-v1:sha256:398e190b6f8a2261d7dadc7e6089a20879caee70fce3c716874cbcb0b8e0602c:"
        },
        {
          "resource": "repo://packages/kit/src/payments.ts#L1-L23",
          "version": "repo-lines-v1:sha256:5a0ff7c60fa08a2692cf1de5acd0e6708e3cbcdc4cbcb6147d12e721033da27d:"
        },
        {
