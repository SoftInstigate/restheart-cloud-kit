  "claims": [
    {
      "id": "claim_acd1c970ec6249f5854fc444f6b659e0",
      "statement": "The @restheart-cloud/cli package ships both a CLI binary (rhc) and a library (defineSetup, step, fromEnv, createAdminClient, createServiceClient, runSetup) for idempotent, file-driven configuration of RESTHeart Cloud services.",
      "evidence": [
        {
          "resource": "repo://packages/cli/package.json",
          "version": "repo-file-v1:sha256:08bb2546a3b324bb438e7e95a8bf9acc237befc1688d2bf055e8d4dc6a109c85"
        },
        {
          "resource": "repo://packages/cli/src/index.ts",
          "version": "repo-file-v1:sha256:0917831eb60535f35123caa2233e3986b4ae6db7217cff4506d0477b632e6166"
        }
      ]
    },
    {
      "id": "claim_d98c78ed2f6942c78f31dcf987c2799a",
      "statement": "The package has two install shapes: global (npm i -g) for the rhc command and devDependency (npm i -D) for the library imports in setup files. The two copies interoperate because Setup is plain data and fromEnv uses Symbol.for for cross-version marker identity.",
      "evidence": [
        {
          "resource": "repo://packages/cli/README.md#L57-L79",
          "version": "repo-lines-v1:sha256:4ba4ee0dc6db3733a00d4ab288897666e96f1b24111f7e1640fc92a3d35b9f85:"
        },
        {
          "resource": "repo://packages/cli/src/env.ts#L21-L21",
          "version": "repo-lines-v1:sha256:c5b5d232fe0b661f39ffa80304478faba7b3013ac08fe7bf3bf6acb18b7ed902:"
        }
      ]
    },
    {
      "id": "claim_3f8d34ee5783498493fd066188180b6b",
      "statement": "The fromEnv function returns a marker object (not a string) identified by Symbol.for('@restheart-cloud/cli:fromEnv'). The marker carries a toString that prints the variable name (never a value) and a toJSON that throws to prevent accidental serialization of unresolved markers.",
      "evidence": [
        {
          "resource": "repo://packages/cli/src/env.ts#L21-L63",
          "version": "repo-lines-v1:sha256:1687cf58c64a2459739b7eb69c414f8f660cc1bc93096cdf46ff29612e11b8bd:"
        }
      ]
    },
    {
      "id": "claim_bfea476d68184bd79a1ee305fd5e88d0",
      "statement": "resolveEnvRefs walks a value tree replacing fromEnv markers with environment values, collecting every missing variable before throwing MissingEnvError so a pipeline learns all missing secrets from one run. Empty strings are treated as missing.",
      "evidence": [
        {
          "resource": "repo://packages/cli/src/env.ts#L108-L134",
          "version": "repo-lines-v1:sha256:08da24f2accab3c1934ef78b647e592fcd205d759c1befb8f833bdc5177e98ff:"
        }
      ]
    },
    {
      "id": "claim_1c1f208c575e470992c7248435da96f2",
      "statement": "Resolution of fromEnv markers happens at serialization time inside the admin client's updatePluginConfig and the service client's body() helper — never before, and a dry run never calls apply so markers are never resolved.",
      "evidence": [
        {
          "resource": "repo://packages/cli/src/admin.ts#L208-L213",
          "version": "repo-lines-v1:sha256:9202a5f24477b0be69cecbc3414cf94faae73941f76c5be911297117878f7354:"
        },
        {
          "resource": "repo://packages/cli/src/service.ts#L101-L102",
          "version": "repo-lines-v1:sha256:44d858a694e4d0034e6f0b1d8f1f125dbfa7005225b85ae180f90531adc399cc:"
        }
      ]
    },
    {
      "id": "claim_b7f69fc1d1554866ba30092f0b6566a0",
      "statement": "Session management stores a personal access token and the admin node it was verified against at ~/.config/restheart/session.json (or under XDG_CONFIG_HOME) with mode 0600 on both directory and file. A corrupt file reads as absent rather than throwing.",
      "evidence": [
        {
          "resource": "repo://packages/cli/src/session.ts#L37-L86",
          "version": "repo-lines-v1:sha256:fd659e5dcaf19830e797ab2a9ed4777316fd1abf8cfc8f4d1a5153a46b5c8027:"
        }
      ]
    },
    {
      "id": "claim_17006ca23aad40aa92d982e3cc301554",
      "statement": "resolveToken implements strict precedence: RH_CLOUD_TOKEN env var always wins over the stored session file, with no conditions attached. This prevents a CI run from silently falling back to a session left on a shared runner.",
      "evidence": [
        {
          "resource": "repo://packages/cli/src/session.ts#L88-L110",
          "version": "repo-lines-v1:sha256:072f4df3d8f9af812037fa6c411f07a15618c8f49cbb6c5ccf31f2d3dea181d4:"
        }
      ]
    },
    {
      "id": "claim_c123e72b7c3045df9492c1098f7641b9",
      "statement": "The CLI commands are login, logout, and setup. login verifies a token against the admin node before storing it. setup loads a setup file (default ./rhc.setup.ts), resolves credentials, and runs steps. The rhc new command for provisioning is specified but not built.",
      "evidence": [
        {
          "resource": "repo://packages/cli/src/cli.ts#L111-L112",
          "version": "repo-lines-v1:sha256:003338ea3e1fd582e844715562d498c14fa491b9c156e45792413b3b63048e59:"
