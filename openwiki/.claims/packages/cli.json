    },
    {
      "id": "claim_31c6a10ecdc5497483a330f784c0acad",
      "statement": "Progress events emit only a step's name and state (never config values or secrets). The CLI renders progress with glyphs (· satisfied, + applied, ? missing, ✗ failed, — skipped) and a summary line. JSON output is available via --json.",
      "evidence": [
