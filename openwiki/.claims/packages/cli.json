          "version": "repo-lines-v1:sha256:da952d45ac18835b0f9499f3f180b59d7cd3195ad5094d11a1cc873dccd57dca:"
        }
      ]
    },
    {
      "id": "claim_3c3b398a500f4064ab7ea1f6c94a4475",
      "statement": "The setup file is resolved from --file or the first conventional name (rhc.setup.ts, .mts, .js, .mjs) in the working directory. It accepts a default export or named 'setup' export; a function export is called with no arguments.",
      "evidence": [
        {
          "resource": "repo://packages/cli/src/cli.ts#L177-L255",
          "version": "repo-lines-v1:sha256:ad6f5c3041049d0f9865d167c7fd2c90a1a7f854191d2e0863f7ffe1a6d882ec:"
        },
        {
          "resource": "repo://packages/cli/src/cli.ts#L48-L49",
