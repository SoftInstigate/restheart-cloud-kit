{
  "name": "@restheart-cloud/cli",
  "version": "0.0.0",
  "description": "The RESTHeart Cloud CLI. Configure a service from a plan committed to git — collections, indexes, permissions and plugins, applied idempotently from a terminal or a CI pipeline.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "rhc": "./dist/cli.js"
  },
  "keywords": [
    "restheart",
    "restheart-cloud",
    "cli",
    "configuration",
    "infrastructure-as-code"
  ],
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoftInstigate/restheart-cloud-kit.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts"
  },
  "dependencies": {
    "@restheart-cloud/kit": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "^4"
  }
}
